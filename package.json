{
  "name": "solana-pay-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude invoice, get paid, and pay in USDC on Solana. Stripe agent toolkit, but USDC on Solana.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "solana-pay-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana/kit": "^8.4.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkebo/solana-pay-mcp.git"
  },
  "homepage": "https://github.com/monkebo/solana-pay-mcp#readme",
  "bugs": {
    "url": "https://github.com/monkebo/solana-pay-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "usdc",
    "payments",
    "invoice",
    "solana-pay",
    "claude",
    "agent"
  ],
  "author": "monkebo",
  "publishConfig": {
    "access": "public"
  }
}
