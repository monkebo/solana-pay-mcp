{
  "name": "solana-pay-mcp",
  "version": "0.4.0",
  "description": "Solana agentic wallet: a policy-controlled wallet for AI agents (CLI + MCP + skill) that runs on your own key, Binance Agentic Wallet, any HTTP signer, or a human wallet. Invoices, x402, swaps, limit orders, external signing.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "saw": "dist/saw.js",
    "solana-pay-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "ui",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run gen:skill",
    "gen:skill": "tsx src/docs.ts skills/solana-agentic-wallet",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-signer": "^0.19.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkebo/solana-pay-mcp.git"
  },
  "homepage": "https://github.com/monkebo/solana-pay-mcp#readme",
  "bugs": {
    "url": "https://github.com/monkebo/solana-pay-mcp/issues"
  },
  "keywords": [
    "agent",
    "agentic-wallet",
    "binance",
    "claude",
    "invoice",
    "jupiter",
    "mcp",
    "model-context-protocol",
    "openclaw",
    "payments",
    "skill",
    "solana",
    "solana-pay",
    "usdc",
    "wallet",
    "x402"
  ],
  "author": "monkebo",
  "publishConfig": {
    "access": "public"
  }
}
